# ---- .NET / build output ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.user
*.suo
*.userprefs
*.binlog
artifacts/
publish/
[Pp]ublish/
dist/

# ---- IDE ----
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.shared.json
.idea/
*.DotSettings.user

# ---- Rider / ReSharper ----
_ReSharper*/
*.[Rr]e[Ss]harper

# ---- Test / coverage ----
[Tt]est[Rr]esults/
coverage*
*.coverage
*.trx

# ---- NuGet ----
*.nupkg
*.snupkg
.nuget/
packages/

# ---- App runtime data (never commit real workspace data) ----
/data/
*.db
*.db-wal
*.db-shm
/logs/
*.log

# ---- Local build logs from build.bat (send these to review, don't commit) ----
/build-logs/

# ---- OS ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Local secrets / machine config ----
*.local.json
appsettings.Development.json

# Installer build artifacts (scripts + docs are tracked; outputs are not)
installer/publish/
installer/releases/
installer/logs/

# .NET SDK/herramientas locales que provisiona scripts\dotnet-bootstrap.bat
# cuando el equipo no tiene un SDK compatible (no se sube al repo).
/.dotnet/
/.dotnet-tools/
/.tools/
installer/.tools/
