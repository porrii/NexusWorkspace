<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             xmlns:shared="clr-namespace:NexusWorkspace.UI.Views.Shared"
             x:Class="NexusWorkspace.UI.Views.Projects.ProjectDetailView">

  <StackPanel Spacing="16" MaxWidth="1040">

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />

    <!-- Header -->
    <Border Classes="card" IsVisible="{Binding Header, Converter={x:Static conv:AppConverters.IsNotNull}}">
      <StackPanel Spacing="12" DataContext="{Binding Header}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
            <mi:MaterialIcon Kind="FolderOutline" Width="26" Height="26" VerticalAlignment="Center"
                             Foreground="{DynamicResource AppAccentBrush}" />
            <TextBlock Text="{Binding Name}" Classes="h1" VerticalAlignment="Center" />
            <Border Classes="pill" VerticalAlignment="Center"
                    BorderBrush="{Binding Status, Converter={x:Static conv:AppConverters.ProjectStatusBrush}}">
              <TextBlock Text="{Binding Status, Converter={x:Static conv:AppConverters.EnumLabel}}"
                         Foreground="{Binding Status, Converter={x:Static conv:AppConverters.ProjectStatusBrush}}" />
            </Border>
            <Border Classes="pill" VerticalAlignment="Center"
                    BorderBrush="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}">
              <TextBlock Text="{Binding Priority, Converter={x:Static conv:AppConverters.EnumLabel}}"
                         Foreground="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}" />
            </Border>
            <Border Classes="pill" VerticalAlignment="Center" IsVisible="{Binding IsArchived}"
                    BorderBrush="{DynamicResource SemWarningBrush}">
              <TextBlock Text="Archivado" Foreground="{DynamicResource SemWarningBrush}" />
            </Border>
          </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted"
                   IsVisible="{Binding Description, Converter={x:Static conv:AppConverters.HasText}}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding ProgressPercent, StringFormat='{}Progreso {0}%'}" Classes="muted" VerticalAlignment="Center" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Width="240" Height="6" VerticalAlignment="Center" />
          <TextBlock Text="{Binding OpenTaskCount, StringFormat='{}· {0} abiertas'}" Classes="muted" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FinishedTaskCount, StringFormat='{}· {0} finalizadas'}" Classes="muted" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Classes="muted" Text="{Binding StartDateUtc, Converter={x:Static conv:AppConverters.LocalDate}, StringFormat='{}Inicio: {0}'}" />
          <TextBlock Classes="muted" Text="{Binding DueDateUtc, Converter={x:Static conv:AppConverters.LocalDate}, StringFormat='{}Previsto: {0}'}" />
          <TextBlock Classes="muted" Text="{Binding OwnerName, StringFormat='{}Responsable: {0}'}"
                     IsVisible="{Binding OwnerName, Converter={x:Static conv:AppConverters.HasText}}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Tags -->
    <StackPanel Spacing="6" IsVisible="{Binding Header, Converter={x:Static conv:AppConverters.IsNotNull}}">
      <ItemsControl ItemsSource="{Binding Header.Tags}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="pill" Margin="0,0,6,4"
                    BorderBrush="{Binding DisplayColor, Converter={x:Static conv:AppConverters.HexBrush}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Name}"
                           Foreground="{Binding DisplayColor, Converter={x:Static conv:AppConverters.HexBrush}}" />
                <Button Padding="0" Background="Transparent" BorderThickness="0"
                        Command="{Binding $parent[ItemsControl].DataContext.RemoveTagCommand}" CommandParameter="{Binding}">
                  <mi:MaterialIcon Kind="Close" Width="11" Height="11" />
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Añadir etiqueta" Classes="muted" VerticalAlignment="Center" />
        <ComboBox Width="200" PlaceholderText="Elegir…" ItemsSource="{Binding AllTags}"
                  SelectionChanged="OnAddTagSelected">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <!-- Equipo y empresas -->
    <Border Classes="card" IsVisible="{Binding Header, Converter={x:Static conv:AppConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
          <TextBlock Text="Equipo" Classes="h2" />
          <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Añadir persona…"
                    ItemsSource="{Binding UnlinkedPeople}" SelectionChanged="OnLinkPersonSelected">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ItemsControl ItemsSource="{Binding Header.Team}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" VerticalAlignment="Center"
                             Text="{Binding Name}" />
                  <Button Grid.Column="1" Classes="quick" Padding="4,2" ToolTip.Tip="Quitar del equipo"
                          Command="{Binding $parent[ItemsControl].DataContext.UnlinkPersonCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Close" Width="13" Height="13" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Text="Empresas" Classes="h2" />
          <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Vincular empresa…"
                    ItemsSource="{Binding UnlinkedCompanies}" SelectionChanged="OnLinkCompanySelected">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ItemsControl ItemsSource="{Binding Header.Companies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="quick" Padding="4,2" ToolTip.Tip="Desvincular"
                          Command="{Binding $parent[ItemsControl].DataContext.UnlinkCompanyCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Close" Width="13" Height="13" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Actions -->
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Cambiar estado" Classes="muted" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding AvailableStatuses}" Width="200"
                SelectedItem="{Binding SelectedStatus, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static conv:AppConverters.EnumLabel}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Editar proyecto" Classes="accent" Command="{Binding ToggleEditPanelCommand}" />
      <Button Content="{Binding Header.IsArchived, Converter={x:Static conv:AppConverters.ArchiveLabel}}"
              Command="{Binding ArchiveCommand}" />
      <Button Content="Guardar como plantilla" Classes="quick" Command="{Binding ToggleTemplatePanelCommand}" />
      <Button Classes="quick">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <mi:MaterialIcon Kind="FileExportOutline" Width="14" Height="14" />
          <TextBlock Text="Exportar informe" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="PDF" Command="{Binding ExportReportCommand}" CommandParameter="pdf" />
            <MenuItem Header="Excel" Command="{Binding ExportReportCommand}" CommandParameter="excel" />
            <MenuItem Header="CSV" Command="{Binding ExportReportCommand}" CommandParameter="csv" />
            <MenuItem Header="JSON" Command="{Binding ExportReportCommand}" CommandParameter="json" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </StackPanel>

    <!-- Edit panel -->
    <Border Classes="card" IsVisible="{Binding IsEditPanelOpen}">
      <StackPanel Spacing="10">
        <TextBlock Text="Editar proyecto" Classes="h2" />
        <TextBlock Text="Nombre" Classes="muted" />
        <TextBox Text="{Binding EditName, Mode=TwoWay}" />
        <TextBlock Text="Descripción" Classes="muted" />
        <TextBox Text="{Binding EditDescription, Mode=TwoWay}" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="90" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Prioridad" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8" />
          <ComboBox Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"
                    ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditPriority, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:AppConverters.EnumLabel}}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Inicio" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <DatePicker SelectedDate="{Binding EditStartDate, Mode=TwoWay}" />
            <Button Content="Sin fecha" Classes="quick" Command="{Binding ClearEditStartDateCommand}" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Previsto" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <DatePicker SelectedDate="{Binding EditDueDate, Mode=TwoWay}" />
            <Button Content="Sin fecha" Classes="quick" Command="{Binding ClearEditDueDateCommand}" />
          </StackPanel>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Responsable" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <ComboBox Width="260" ItemsSource="{Binding AllPeople}" SelectedItem="{Binding EditOwner, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Quitar" Classes="quick" Command="{Binding ClearEditOwnerCommand}" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding ToggleEditPanelCommand}" />
          <Button Content="Guardar" Classes="accent" Command="{Binding SaveDetailsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsTemplatePanelOpen}">
      <StackPanel Spacing="10">
        <TextBlock Text="Guardar el proyecto como plantilla" Classes="h2" />
        <TextBlock Classes="muted" Text="Captura las tareas, subtareas, checklist y etiquetas como un árbol reutilizable." />
        <TextBox Watermark="Nombre de la plantilla" Text="{Binding TemplateName, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding ToggleTemplatePanelCommand}" />
          <Button Content="Guardar plantilla" Classes="accent" Command="{Binding SaveAsTemplateCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding ExportMessage}" Classes="muted" TextWrapping="Wrap"
               IsVisible="{Binding ExportMessage, Converter={x:Static conv:AppConverters.HasText}}" />

    <!-- Tabs -->
    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

      <TabItem Header="Tareas">
        <StackPanel Spacing="12" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Command="{Binding ToggleCreateTaskPanelCommand}" Classes="accent">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                <TextBlock Text="Nueva tarea" />
              </StackPanel>
            </Button>
            <CheckBox Content="Ver finalizadas" IsChecked="{Binding ShowFinishedTasks, Mode=TwoWay}" />
          </StackPanel>

          <Border Classes="card" IsVisible="{Binding IsCreateTaskPanelOpen}">
            <StackPanel Spacing="10">
              <TextBox Watermark="Título de la tarea" Text="{Binding NewTaskTitle, Mode=TwoWay}" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Prioridad" Classes="muted" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewTaskPriority, Mode=TwoWay}" Width="160">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={x:Static conv:AppConverters.EnumLabel}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Crear" Classes="accent" Command="{Binding CreateTaskCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="row" Margin="0,0,0,8" Tag="{Binding}" PointerReleased="OnTaskClicked">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Classes="pill" Margin="0,0,10,0" VerticalAlignment="Center"
                            BorderBrush="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}">
                      <TextBlock Text="{Binding Priority, Converter={x:Static conv:AppConverters.EnumLabel}}"
                                 Foreground="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="muted" Text="{Binding Status, Converter={x:Static conv:AppConverters.EnumLabel}}" />
                        <TextBlock Classes="muted" Text="{Binding SubTaskProgressPercent, StringFormat='{}Subtareas {0}%'}"
                                   IsVisible="{Binding SubTaskTotal, Converter={x:Static conv:AppConverters.Positive}}" />
                        <TextBlock Classes="muted" Text="{Binding DueDateUtc, Converter={x:Static conv:AppConverters.LocalDate}, StringFormat='{}Vence {0}'}"
                                   IsVisible="{Binding DueDateUtc, Converter={x:Static conv:AppConverters.IsNotNull}}" />
                      </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Width="9" Height="9" CornerRadius="99" VerticalAlignment="Center"
                            Background="{Binding Status, Converter={x:Static conv:AppConverters.TaskStatusBrush}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </TabItem>

      <TabItem Header="Resumen">
        <StackPanel Spacing="10" Margin="0,12,0,0">
          <TextBlock Text="Descripción" Classes="h2" />
          <TextBlock Text="{Binding Header.Description}" TextWrapping="Wrap"
                     IsVisible="{Binding Header.Description, Converter={x:Static conv:AppConverters.HasText}}" />
          <TextBlock Text="Sin descripción." Classes="muted"
                     IsVisible="{Binding Header.Description, Converter={x:Static conv:AppConverters.IsBlank}}" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Seguimientos">
        <StackPanel Spacing="10" Margin="0,12,0,0">
          <ItemsControl ItemsSource="{Binding FollowUps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="row" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" Spacing="1">
                      <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="muted" Text="{Binding WaitingOn, StringFormat='{}⏳ {0}'}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemWaitingBrush}"
                               Text="{Binding DaysWaiting, StringFormat='{}{0} d'}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                IsVisible="{Binding IsOpen}">
                      <Button Content="Recordatorio" Classes="quick"
                              Command="{Binding $parent[ItemsControl].DataContext.SendFollowUpReminderCommand}" CommandParameter="{Binding}" />
                      <Button Content="Respondió" Classes="quick"
                              Command="{Binding $parent[ItemsControl].DataContext.ResolveFollowUpCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Reminders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                  <TextBlock Grid.Column="0" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Margin="8,0"
                             Text="{Binding RemindAtUtc, Converter={x:Static conv:AppConverters.DayDelta}}" />
                  <Button Grid.Column="2" Content="Hecho" Classes="quick" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].DataContext.CompleteReminderCommand}" CommandParameter="{Binding}"
                          IsVisible="{Binding Status, Converter={x:Static conv:AppConverters.ReminderPending}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Iniciar seguimiento" Classes="quick" Command="{Binding ToggleFollowUpPanelCommand}" />
            <Button Content="Nuevo recordatorio" Classes="quick" Command="{Binding ToggleReminderPanelCommand}" />
          </StackPanel>

          <Border Classes="tile" IsVisible="{Binding IsFollowUpPanelOpen}">
            <StackPanel Spacing="8">
              <TextBox Watermark="¿Qué estás esperando?" Text="{Binding FollowUpSubject, Mode=TwoWay}" />
              <TextBox Watermark="¿De quién?" Text="{Binding FollowUpWaitingOn, Mode=TwoWay}" />
              <Button Content="Empezar a esperar" Classes="accent" HorizontalAlignment="Right"
                      Command="{Binding StartFollowUpCommand}" />
            </StackPanel>
          </Border>

          <Border Classes="tile" IsVisible="{Binding IsReminderPanelOpen}">
            <StackPanel Spacing="8">
              <TextBox Watermark="Recordarme…" Text="{Binding NewReminderText, Mode=TwoWay}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <DatePicker SelectedDate="{Binding NewReminderDate, Mode=TwoWay}" />
                <TimePicker SelectedTime="{Binding NewReminderTime, Mode=TwoWay}" ClockIdentifier="24HourClock" />
                <Button Content="Crear" Classes="accent" Command="{Binding AddReminderCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </TabItem>

      <TabItem Header="Tablero">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,12,0,0">
          <ItemsControl ItemsSource="{Binding Board}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="240" Padding="10" CornerRadius="10" VerticalAlignment="Top"
                        Background="{DynamicResource AppSurfaceAltBrush}"
                        BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="1"
                        DragDrop.AllowDrop="True">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                      <Border Grid.Column="1" Classes="pill" BorderBrush="{DynamicResource AppLineStrongBrush}">
                        <TextBlock Text="{Binding Count}" Foreground="{DynamicResource AppMutedBrush}" />
                      </Border>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Cards}" MinHeight="40">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="row" Margin="0,0,0,8" Padding="10,8" Tag="{Binding}"
                                  PointerPressed="OnCardPointerPressed" PointerReleased="OnCardClicked">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="pill"
                                        BorderBrush="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}">
                                  <TextBlock Text="{Binding Priority, Converter={x:Static conv:AppConverters.EnumLabel}}"
                                             Foreground="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}" />
                                </Border>
                                <TextBlock Classes="muted" VerticalAlignment="Center"
                                           Text="{Binding DueDateUtc, Converter={x:Static conv:AppConverters.LocalDate}}"
                                           IsVisible="{Binding DueDateUtc, Converter={x:Static conv:AppConverters.IsNotNull}}" />
                              </StackPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Cronología">
        <ItemsControl ItemsSource="{Binding TimelineDays}" Margin="0,12,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="6" Margin="0,0,0,14">
                <TextBlock Text="{Binding Label}" Classes="kicker" />
                <ItemsControl ItemsSource="{Binding Events}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <Border Grid.Column="0" Width="26" Margin="0,0,10,0">
                          <mi:MaterialIcon Width="17" Height="17" VerticalAlignment="Top"
                                           Kind="{Binding Type, Converter={x:Static conv:AppConverters.ActivityTypeIcon}}"
                                           Foreground="{Binding Type, Converter={x:Static conv:AppConverters.ActivityTypeBrush}}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap"
                                     IsVisible="{Binding Note, Converter={x:Static conv:AppConverters.HasText}}" />
                          <TextBlock Classes="muted"
                                     Text="{Binding OccurredAtUtc, Converter={x:Static conv:AppConverters.RelativeDateTime}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </TabItem>

      <TabItem Header="Adjuntos">
        <shared:AttachmentsPanel DataContext="{Binding Attachments}" Margin="0,12,0,0" />
      </TabItem>

    </TabControl>

  </StackPanel>

</UserControl>
