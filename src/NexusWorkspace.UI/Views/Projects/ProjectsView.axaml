<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.Projects.ProjectsView">

  <StackPanel Spacing="16" MaxWidth="1000">

    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
      <TextBlock Grid.Column="0" Text="Proyectos" Classes="h1" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" Width="240" Watermark="Buscar…" Margin="0,0,10,0"
               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ToggleSwitch Grid.Column="2" OnContent="Archivados" OffContent="Activos" Margin="0,0,10,0"
                    IsChecked="{Binding ShowArchived, Mode=TwoWay}" />
      <Button Grid.Column="3" Command="{Binding ToggleCreatePanelCommand}" Classes="accent">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
          <TextBlock Text="Nuevo proyecto" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Classes="card" IsVisible="{Binding IsCreatePanelOpen}">
      <StackPanel Spacing="10">
        <TextBlock Text="Nuevo proyecto" Classes="h2" />
        <TextBox Watermark="Nombre" Text="{Binding NewProjectName, Mode=TwoWay}" />
        <TextBox Watermark="Descripción (opcional)" AcceptsReturn="True" MinHeight="60"
                 Text="{Binding NewProjectDescription, Mode=TwoWay}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Prioridad" VerticalAlignment="Center" Classes="muted" />
          <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewProjectPriority, Mode=TwoWay}" Width="160">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={x:Static conv:AppConverters.EnumLabel}}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding ToggleCreatePanelCommand}" />
          <Button Content="Crear" Classes="accent" Command="{Binding CreateProjectCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Projects}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="row" Margin="0,0,0,10" Tag="{Binding}" PointerReleased="OnProjectClicked">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Width="10" Height="10" CornerRadius="99" Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Background="{Binding Status, Converter={x:Static conv:AppConverters.ProjectStatusBrush}}" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                <TextBlock Text="{Binding Description}" Classes="muted" MaxLines="1" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Description, Converter={x:Static conv:AppConverters.HasText}}" />
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <TextBlock Classes="muted"
                             Text="{Binding Status, Converter={x:Static conv:AppConverters.EnumLabel}}" />
                  <TextBlock Classes="muted"
                             Text="{Binding OpenTaskCount, StringFormat='{}{0} tareas abiertas'}" />
                  <TextBlock Classes="muted"
                             Text="{Binding ProgressPercent, StringFormat='{}{0}% completado'}" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center"
                      BorderBrush="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}">
                <TextBlock Text="{Binding Priority, Converter={x:Static conv:AppConverters.EnumLabel}}"
                           Foreground="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}" />
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Spacing="6" IsVisible="{Binding IsEmpty}" Margin="0,20,0,0" HorizontalAlignment="Center">
      <TextBlock Text="No hay proyectos que mostrar." Classes="muted" HorizontalAlignment="Center" />
      <Button Content="Crear el primero" Classes="accent" HorizontalAlignment="Center"
              Command="{Binding ToggleCreatePanelCommand}" />
    </StackPanel>

  </StackPanel>

</UserControl>
