<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NexusWorkspace.UI.Views.CommandPalette.CommandPaletteView"
             Width="560">

  <Border Background="{DynamicResource AppSurfaceBrush}"
          BorderBrush="{DynamicResource AppLineStrongBrush}"
          BorderThickness="1" CornerRadius="14" Padding="8"
          BoxShadow="0 24 70 -24 #66000000">
    <DockPanel>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="8,6,8,8">
        <mi:MaterialIcon Grid.Column="0" Kind="ConsoleLine" Width="18" Height="18"
                         VerticalAlignment="Center" Margin="0,0,10,0"
                         Foreground="{DynamicResource AppMutedBrush}" />
        <TextBox x:Name="Input" Grid.Column="1" BorderThickness="0" Background="Transparent"
                 FontSize="15" Watermark="Escribe una acción…  (Ctrl+K)"
                 Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="OnInputKeyDown" />
      </Grid>

      <ListBox x:Name="ResultsList" MaxHeight="360"
               ItemsSource="{Binding Results}"
               SelectedItem="{Binding Selected, Mode=TwoWay}"
               Background="Transparent" BorderThickness="0"
               DoubleTapped="OnResultActivated">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,*,Auto" Height="34">
              <mi:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="17" Height="17"
                               VerticalAlignment="Center" Margin="2,0,12,0" />
              <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Category}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </DockPanel>
  </Border>

</UserControl>
