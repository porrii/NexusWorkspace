<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.Activity.ActivityView">

  <StackPanel Spacing="16" MaxWidth="900">

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="Actividad" Classes="h1" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Mostrar" Classes="muted" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding Limit, Mode=TwoWay}" Width="90" />
      </StackPanel>
    </Grid>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />

    <Border Classes="card">
      <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{Binding Entries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                <TextBlock Grid.Column="0" Classes="muted" MinWidth="150"
                           Text="{Binding OccurredAtUtc, Converter={x:Static conv:AppConverters.LocalDateTime}}" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding Note}"
                             IsVisible="{Binding Note, Converter={x:Static conv:AppConverters.HasText}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Todavía no hay actividad registrada." Classes="muted"
                   IsVisible="{Binding IsEmpty}" />
      </StackPanel>
    </Border>

  </StackPanel>

</UserControl>
