<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.Activity.ActivityView">

  <StackPanel Spacing="16" MaxWidth="920">

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="Actividad" Classes="h1" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Máx." Classes="muted" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding Limit, Mode=TwoWay}" Width="90" />
      </StackPanel>
    </Grid>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />

    <!-- Filtros -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
            <TextBlock Text="Proyecto" Classes="muted" VerticalAlignment="Center" />
            <ComboBox Width="200" ItemsSource="{Binding ProjectOptions}"
                      SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
            <TextBlock Text="De qué" Classes="muted" VerticalAlignment="Center" />
            <ComboBox Width="150" ItemsSource="{Binding KindOptions}"
                      SelectedItem="{Binding SelectedKind, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
            <TextBlock Text="Desde" Classes="muted" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" />
            <TextBlock Text="Hasta" Classes="muted" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <TextBox Width="200" Watermark="Buscar en el texto…" Text="{Binding SearchText, Mode=TwoWay}" />
            <Button Content="Buscar" Command="{Binding ApplySearchCommand}" />
            <Button Content="Limpiar" Classes="quick" Command="{Binding ClearFiltersCommand}" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Days}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Spacing="8" Margin="0,0,0,14">
            <TextBlock Text="{Binding Header}" Classes="h2" />
            <Border Classes="card">
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                      <TextBlock Grid.Column="0" Classes="muted" MinWidth="70"
                                 Text="{Binding OccurredAtUtc, Converter={x:Static conv:AppConverters.LocalTime}}" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{Binding Note}"
                                   IsVisible="{Binding Note, Converter={x:Static conv:AppConverters.HasText}}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="No hay actividad que coincida con los filtros." Classes="muted"
               IsVisible="{Binding IsEmpty}" />

  </StackPanel>

</UserControl>
