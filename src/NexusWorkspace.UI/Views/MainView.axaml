<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.MainView"
             Background="{DynamicResource AppGroundBrush}">

  <Panel>

    <Grid ColumnDefinitions="Auto,*">

      <!-- Sidebar -->
      <Border Grid.Column="0"
              Width="{Binding IsSidebarExpanded, Converter={x:Static conv:AppConverters.SidebarWidth}}"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppLineBrush}"
              BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True" Margin="8,12">

          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="6,0,4,14">
            <Button Grid.Column="0" Command="{Binding ToggleSidebarCommand}"
                    Classes="quick" Padding="7" ToolTip.Tip="Contraer / expandir (barra lateral)"
                    AutomationProperties.Name="Contraer o expandir la barra lateral">
              <mi:MaterialIcon Kind="Menu" Width="18" Height="18" />
            </Button>
            <TextBlock Grid.Column="1" Text="NexusWorkspace"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppInkBrush}"
                       Opacity="{Binding IsSidebarExpanded, Converter={x:Static conv:AppConverters.ExpandedToOpacity}}" />

            <Button Grid.Column="2" Classes="quick" Padding="7" ToolTip.Tip="Notificaciones"
                    AutomationProperties.Name="Abrir notificaciones"
                    Command="{Binding Notifications.ToggleCommand}">
              <Panel>
                <mi:MaterialIcon Kind="BellOutline" Width="18" Height="18" />
                <Border Background="{DynamicResource SemCriticalBrush}" CornerRadius="99"
                        MinWidth="15" Height="15" Padding="3,0" Margin="0,-8,-8,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        IsVisible="{Binding Notifications.HasUnread}">
                  <TextBlock Text="{Binding Notifications.UnreadCount}" FontSize="9" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedTop">
                  <Border Width="360" Padding="4">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Notificaciones" Classes="h2" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Marcar todo leído" Classes="quick"
                                Command="{Binding Notifications.MarkAllReadCommand}" />
                      </Grid>
                      <ScrollViewer MaxHeight="380">
                        <ItemsControl ItemsSource="{Binding Notifications.Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="row" Margin="0,0,0,6" Tag="{Binding}" PointerReleased="OnNotificationClicked">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Body}" Classes="muted" TextWrapping="Wrap"
                                             IsVisible="{Binding Body, Converter={x:Static conv:AppConverters.HasText}}" />
                                  <TextBlock Classes="muted"
                                             Text="{Binding CreatedAtUtc, Converter={x:Static conv:AppConverters.RelativeDateTime}}" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="Nada por aquí." Classes="muted"
                                 IsVisible="{Binding Notifications.Items.Count, Converter={x:Static conv:AppConverters.IsZero}}" />
                    </StackPanel>
                  </Border>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>

          <Button DockPanel.Dock="Bottom"
                  Command="{Binding CycleThemeCommand}"
                  Classes="quick" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Margin="4,10,4,0"
                  ToolTip.Tip="Cambiar tema (claro / oscuro / sistema)">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding ThemeGlyph}" FontSize="15" />
              <TextBlock Text="Tema"
                         Opacity="{Binding IsSidebarExpanded, Converter={x:Static conv:AppConverters.ExpandedToOpacity}}" />
            </StackPanel>
          </Button>

          <ListBox ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" Height="30">
                  <mi:MaterialIcon Kind="{Binding Icon}" Width="19" Height="19" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="13"
                             Opacity="{Binding $parent[ListBox].DataContext.IsSidebarExpanded, Converter={x:Static conv:AppConverters.ExpandedToOpacity}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </DockPanel>
      </Border>

      <!-- Content -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">

        <Border Grid.Row="0" Padding="18,12"
                IsVisible="{Binding CanGoBack}"
                BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,0,0,1">
          <Button Command="{Binding GoBackCommand}" Classes="quick">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <mi:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" />
              <TextBlock Text="Atrás" />
            </StackPanel>
          </Button>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <TransitioningContentControl Content="{Binding CurrentPage}" Margin="28,24,28,40" />
        </ScrollViewer>

      </Grid>

    </Grid>

    <!-- Command palette overlay -->
    <Border IsVisible="{Binding IsCommandPaletteOpen}" Background="#59000000" ZIndex="100"
            PointerPressed="OnOverlayBackdropPressed">
      <ContentControl Content="{Binding Palette}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,110,0,0" />
    </Border>

    <!-- Global search overlay -->
    <Border IsVisible="{Binding IsSearchOpen}" Background="#59000000" ZIndex="100"
            PointerPressed="OnOverlayBackdropPressed">
      <ContentControl Content="{Binding Search}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0" />
    </Border>

  </Panel>

</UserControl>
