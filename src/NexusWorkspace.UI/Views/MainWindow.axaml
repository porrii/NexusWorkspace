<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NexusWorkspace.UI.Views"
        x:Class="NexusWorkspace.UI.Views.MainWindow"
        Title="NexusWorkspace"
        Icon="/Assets/app.ico"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="620"
        Background="{DynamicResource AppGroundBrush}"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+F" Command="{Binding OpenSearchCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Space" Command="{Binding QuickCaptureCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseOverlaysCommand}" />
  </Window.KeyBindings>

  <views:MainView />

</Window>
