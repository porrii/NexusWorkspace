<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.Dashboard.DashboardView">

  <StackPanel Spacing="18" MaxWidth="1080">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{Binding Greeting}" Classes="h1" />
        <TextBlock Text="{Binding SummaryLine}" Classes="muted" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding ToggleCustomizeCommand}" Classes="quick" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="Tune" Width="15" Height="15" />
          <TextBlock Text="Personalizar" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Classes="card" Background="{DynamicResource AppAccentWashBrush}" IsVisible="{Binding ShowOnboarding}">
      <StackPanel Spacing="10">
        <TextBlock Text="Bienvenido a NexusWorkspace" Classes="h2" />
        <TextBlock TextWrapping="Wrap" Classes="muted"
                   Text="Tu espacio de trabajo está vacío. Empieza por crear un proyecto, cargar el espacio de demostración para verlo con contenido, o importar tus notas y datos antiguos." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Crear mi primer proyecto" Classes="accent" Command="{Binding StartFirstProjectCommand}" />
          <Button Content="Cargar espacio de demostración" Command="{Binding LoadDemoWorkspaceCommand}" />
          <Button Content="Importar datos" Command="{Binding OpenSettingsForImportCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsCustomizing}">
      <StackPanel Spacing="8">
        <TextBlock Text="Widgets visibles" Classes="h2" />
        <WrapPanel>
          <CheckBox Content="Indicadores" IsChecked="{Binding ShowTiles, Mode=TwoWay}" Margin="0,0,18,0" />
          <CheckBox Content="Captura rápida" IsChecked="{Binding ShowQuickCapture, Mode=TwoWay}" Margin="0,0,18,0" />
          <CheckBox Content="Proyectos activos" IsChecked="{Binding ShowActiveProjects, Mode=TwoWay}" Margin="0,0,18,0" />
          <CheckBox Content="Actividad reciente" IsChecked="{Binding ShowRecentActivity, Mode=TwoWay}" Margin="0,0,18,0" />
          <CheckBox Content="Próximos vencimientos" IsChecked="{Binding ShowUpcoming, Mode=TwoWay}" Margin="0,0,18,0" />
          <CheckBox Content="Recordatorios" IsChecked="{Binding ShowReminders, Mode=TwoWay}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Stat tiles -->
    <UniformGrid Columns="5" IsVisible="{Binding ShowTiles}">
      <Border Classes="tile" Margin="0,0,10,0">
        <StackPanel Spacing="2">
          <TextBlock Text="Pendientes" Classes="muted" />
          <TextBlock Text="{Binding OpenTaskCount}" FontSize="26" FontWeight="SemiBold"
                     Foreground="{DynamicResource AppAccentBrush}" />
        </StackPanel>
      </Border>
      <Border Classes="tile" Margin="0,0,10,0">
        <StackPanel Spacing="2">
          <TextBlock Text="Críticas" Classes="muted" />
          <TextBlock Text="{Binding CriticalTaskCount}" FontSize="26" FontWeight="SemiBold"
                     Foreground="{DynamicResource SemCriticalBrush}" />
        </StackPanel>
      </Border>
      <Border Classes="tile" Margin="0,0,10,0">
        <StackPanel Spacing="2">
          <TextBlock Text="Vencidas" Classes="muted" />
          <TextBlock Text="{Binding OverdueTaskCount}" FontSize="26" FontWeight="SemiBold"
                     Foreground="{DynamicResource SemHighBrush}" />
        </StackPanel>
      </Border>
      <Border Classes="tile" Margin="0,0,10,0">
        <StackPanel Spacing="2">
          <TextBlock Text="Esperando" Classes="muted" />
          <TextBlock Text="{Binding WaitingTaskCount}" FontSize="26" FontWeight="SemiBold"
                     Foreground="{DynamicResource SemWaitingBrush}" />
        </StackPanel>
      </Border>
      <Button Classes="tile" Command="{Binding OpenInboxCommand}" HorizontalContentAlignment="Left" Padding="16">
        <StackPanel Spacing="2">
          <TextBlock Text="Inbox" Classes="muted" />
          <TextBlock Text="{Binding InboxCount}" FontSize="26" FontWeight="SemiBold"
                     Foreground="{DynamicResource AppInkBrush}" />
        </StackPanel>
      </Button>
    </UniformGrid>

    <!-- Inline quick capture -->
    <Border Classes="card" IsVisible="{Binding ShowQuickCapture}">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <mi:MaterialIcon Kind="FlashOutline" Width="16" Height="16"
                           Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Captura rápida" Classes="h2" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="560" Watermark="Escribe algo y pulsa Enter — irá a Inbox…"
                   Text="{Binding CaptureText, Mode=TwoWay}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CaptureCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Content="Guardar" Classes="accent" Command="{Binding CaptureCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- These three reflow with WrapPanel (not a fixed grid) so hiding one doesn't
         leave an empty hole next to the ones that stay. -->
    <WrapPanel>

      <!-- Active projects -->
      <Border Classes="card" Width="531" Margin="0,0,18,18" IsVisible="{Binding ShowActiveProjects}">
        <StackPanel Spacing="12">
          <TextBlock Text="Proyectos activos" Classes="h2" />
          <ItemsControl ItemsSource="{Binding ActiveProjects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="row" Margin="0,0,0,8"
                        PointerReleased="OnProjectRowClicked" Tag="{Binding}">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="9" Height="9" CornerRadius="99" VerticalAlignment="Center"
                              Background="{Binding Status, Converter={x:Static conv:AppConverters.ProjectStatusBrush}}" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" />
                    <TextBlock Classes="muted"
                               Text="{Binding OpenTaskCount, StringFormat='{}{0} abiertas'}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Sin proyectos activos." Classes="muted"
                     IsVisible="{Binding !AnyActiveProjects}" />
        </StackPanel>
      </Border>

      <!-- Recent activity -->
      <Border Classes="card" Width="531" Margin="0,0,18,18" IsVisible="{Binding ShowRecentActivity}">
        <StackPanel Spacing="12">
          <TextBlock Text="Actividad reciente" Classes="h2" />
          <ItemsControl ItemsSource="{Binding RecentActivity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                  <TextBlock Grid.Column="0" Classes="muted" MinWidth="86"
                             Text="{Binding OccurredAtUtc, Converter={x:Static conv:AppConverters.RelativeDateTime}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Summary}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Todavía no hay actividad registrada." Classes="muted"
                     IsVisible="{Binding !AnyRecentActivity}" />
        </StackPanel>
      </Border>

      <!-- Próximos recordatorios -->
      <Border Classes="card" Width="531" Margin="0,0,18,18" IsVisible="{Binding ShowReminders}">
        <StackPanel Spacing="12">
          <TextBlock Text="Próximos recordatorios" Classes="h2" />
          <ItemsControl ItemsSource="{Binding UpcomingReminders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,9">
                  <TextBlock Grid.Column="0" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Margin="8,0"
                             Text="{Binding RemindAtUtc, Converter={x:Static conv:AppConverters.DayDelta}}" />
                  <Button Grid.Column="2" Content="Hecho" Classes="quick" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].DataContext.CompleteReminderCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Sin recordatorios pendientes." Classes="muted" IsVisible="{Binding !AnyReminders}" />
          <StackPanel Spacing="6">
            <TextBox Watermark="Nuevo recordatorio…" Text="{Binding ReminderText, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <DatePicker SelectedDate="{Binding ReminderDate, Mode=TwoWay}" />
              <Button Content="Añadir" Classes="accent" Command="{Binding AddReminderCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

    </WrapPanel>

    <Border Classes="card" IsVisible="{Binding ShowUpcoming}">
      <StackPanel Spacing="12">
        <TextBlock Text="Próximos vencimientos" Classes="h2" />
        <ItemsControl ItemsSource="{Binding UpcomingTasks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <Border Grid.Column="0" Classes="pill" Margin="0,0,10,0"
                        BorderBrush="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}">
                  <TextBlock Text="{Binding Priority, Converter={x:Static conv:AppConverters.EnumLabel}}"
                             Foreground="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                           Text="{Binding DueDateUtc, Converter={x:Static conv:AppConverters.LocalDate}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Nada con fecha límite próxima." Classes="muted"
                   IsVisible="{Binding !AnyUpcoming}" />
      </StackPanel>
    </Border>

  </StackPanel>

</UserControl>
