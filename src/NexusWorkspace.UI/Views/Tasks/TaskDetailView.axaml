<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             xmlns:shared="clr-namespace:NexusWorkspace.UI.Views.Shared"
             x:Class="NexusWorkspace.UI.Views.Tasks.TaskDetailView">

  <StackPanel Spacing="16" MaxWidth="1000">

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />

    <!-- Header -->
    <Border Classes="card" IsVisible="{Binding Detail, Converter={x:Static conv:AppConverters.IsNotNull}}">
      <StackPanel Spacing="12" DataContext="{Binding Detail}">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Classes="pill" VerticalAlignment="Center"
                  BorderBrush="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}">
            <TextBlock Text="{Binding Priority, Converter={x:Static conv:AppConverters.EnumLabel}}"
                       Foreground="{Binding Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}" />
          </Border>
          <TextBlock Text="{Binding Title}" Classes="h1" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Classes="muted" Text="{Binding ProjectName}" />
          <Border Classes="pill" VerticalAlignment="Center"
                  BorderBrush="{Binding Status, Converter={x:Static conv:AppConverters.TaskStatusBrush}}">
            <TextBlock Text="{Binding Status, Converter={x:Static conv:AppConverters.EnumLabel}}"
                       Foreground="{Binding Status, Converter={x:Static conv:AppConverters.TaskStatusBrush}}" />
          </Border>
          <TextBlock Classes="muted"
                     Text="{Binding DueDateUtc, Converter={x:Static conv:AppConverters.LocalDate}, StringFormat='{}Vence {0}'}"
                     IsVisible="{Binding DueDateUtc, Converter={x:Static conv:AppConverters.IsNotNull}}" />
          <TextBlock Classes="muted"
                     Text="{Binding AssigneeName, StringFormat='{}Responsable: {0}'}"
                     IsVisible="{Binding AssigneeName, Converter={x:Static conv:AppConverters.HasText}}" />
          <TextBlock Classes="muted"
                     Text="{Binding RelatedCompanyName, StringFormat='{}Empresa: {0}'}"
                     IsVisible="{Binding RelatedCompanyName, Converter={x:Static conv:AppConverters.HasText}}" />
        </StackPanel>
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted"
                   IsVisible="{Binding Description, Converter={x:Static conv:AppConverters.HasText}}" />
      </StackPanel>
    </Border>

    <!-- Tags -->
    <StackPanel Spacing="6" IsVisible="{Binding Detail, Converter={x:Static conv:AppConverters.IsNotNull}}">
      <ItemsControl ItemsSource="{Binding Detail.Tags}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="pill" Margin="0,0,6,4"
                    BorderBrush="{Binding DisplayColor, Converter={x:Static conv:AppConverters.HexBrush}}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Name}"
                           Foreground="{Binding DisplayColor, Converter={x:Static conv:AppConverters.HexBrush}}" />
                <Button Padding="0" Background="Transparent" BorderThickness="0"
                        Command="{Binding $parent[ItemsControl].DataContext.RemoveTagCommand}" CommandParameter="{Binding}">
                  <mi:MaterialIcon Kind="Close" Width="11" Height="11" />
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Añadir etiqueta" Classes="muted" VerticalAlignment="Center" />
        <ComboBox Width="200" PlaceholderText="Elegir…" ItemsSource="{Binding AllTags}"
                  SelectionChanged="OnAddTagSelected">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <!-- Status / priority / edit / archive -->
    <StackPanel Orientation="Horizontal" Spacing="10">
      <ComboBox ItemsSource="{Binding AvailableStatuses}" Width="190"
                SelectedItem="{Binding SelectedStatus, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:AppConverters.EnumLabel}}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox ItemsSource="{Binding Priorities}" Width="150"
                SelectedItem="{Binding Detail.Priority, Mode=OneWay}"
                SelectionChanged="OnPrioritySelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:AppConverters.EnumLabel}}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Editar tarea" Classes="accent" Command="{Binding ToggleEditPanelCommand}" />
      <Button Content="Archivar / Restaurar" Command="{Binding ArchiveCommand}" />
    </StackPanel>

    <!-- Edit panel -->
    <Border Classes="card" IsVisible="{Binding IsEditPanelOpen}">
      <StackPanel Spacing="10">
        <TextBlock Text="Editar tarea" Classes="h2" />
        <TextBlock Text="Título" Classes="muted" />
        <TextBox Text="{Binding EditTitle, Mode=TwoWay}" />
        <TextBlock Text="Descripción" Classes="muted" />
        <TextBox Text="{Binding EditDescription, Mode=TwoWay}" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="90" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" >
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Prioridad" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8" />
          <ComboBox Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,0,0,8"
                    ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditPriority, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Converter={x:Static conv:AppConverters.EnumLabel}}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Fecha límite" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <DatePicker SelectedDate="{Binding EditDueDate, Mode=TwoWay}" />
            <TimePicker SelectedTime="{Binding EditDueTime, Mode=TwoWay}" ClockIdentifier="24HourClock" />
            <Button Content="Sin fecha" Classes="quick" Command="{Binding ClearEditDueDateCommand}" />
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Responsable" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,8" />
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <ComboBox Width="260" ItemsSource="{Binding AllPeople}" SelectedItem="{Binding EditAssignee, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Quitar" Classes="quick" Command="{Binding ClearEditAssigneeCommand}" />
          </StackPanel>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Empresa" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <ComboBox Width="260" ItemsSource="{Binding AllCompanies}" SelectedItem="{Binding EditCompany, Mode=TwoWay}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Quitar" Classes="quick" Command="{Binding ClearEditCompanyCommand}" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <Button Content="Cancelar" Command="{Binding ToggleEditPanelCommand}" />
          <Button Content="Guardar" Classes="accent" Command="{Binding SaveDetailsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Colaboradores -->
    <Border Classes="card" IsVisible="{Binding Detail, Converter={x:Static conv:AppConverters.IsNotNull}}">
      <StackPanel Spacing="8">
        <TextBlock Text="Colaboradores" Classes="h2" />
        <ComboBox Width="280" PlaceholderText="Añadir colaborador…" ItemsSource="{Binding CollaboratorCandidates}"
                  SelectionChanged="OnAddCollaboratorSelected">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <ItemsControl ItemsSource="{Binding Detail.Collaborators}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="pill" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" />
                  <Button Padding="0" Background="Transparent" BorderThickness="0"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveCollaboratorCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Close" Width="11" Height="11" />
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Quick actions -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Acciones rápidas" Classes="h2" />
        <TextBox Watermark="Descripción opcional para la próxima acción…"
                 Text="{Binding QuickActionNote, Mode=TwoWay}" />
        <ItemsControl ItemsSource="{Binding QuickActions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="quick" Margin="0,0,8,8"
                      Content="{Binding Label}"
                      Command="{Binding $parent[ItemsControl].DataContext.ExecuteQuickActionCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Subtareas (subtareas + checklist unificados) -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Subtareas" Classes="h2" />
          <TextBlock Classes="muted" VerticalAlignment="Center"
                     Text="{Binding ChildProgress, StringFormat='{}{0}%'}" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ChildProgress}" Height="6" />

        <ItemsControl ItemsSource="{Binding Children}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsDone, Mode=OneWay}"
                          Command="{Binding $parent[ItemsControl].DataContext.ToggleChildCommand}"
                          CommandParameter="{Binding}" />

                <!-- read mode -->
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                           TextWrapping="Wrap" IsVisible="{Binding !IsEditing}"
                           DoubleTapped="OnChildTitleDoubleTapped" />
                <!-- edit mode -->
                <TextBox Grid.Column="1" Text="{Binding EditText, Mode=TwoWay}" IsVisible="{Binding IsEditing}"
                         KeyDown="OnChildEditKeyDown" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Classes="quick" Padding="4,2" ToolTip.Tip="Subir"
                          Command="{Binding $parent[ItemsControl].DataContext.MoveChildUpCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="ChevronUp" Width="14" Height="14" />
                  </Button>
                  <Button Classes="quick" Padding="4,2" ToolTip.Tip="Bajar"
                          Command="{Binding $parent[ItemsControl].DataContext.MoveChildDownCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="ChevronDown" Width="14" Height="14" />
                  </Button>
                  <Button Classes="quick" Padding="4,2" ToolTip.Tip="Renombrar"
                          Command="{Binding $parent[ItemsControl].DataContext.StartRenameChildCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Pencil" Width="14" Height="14" />
                  </Button>
                  <Button Classes="quick" Padding="4,2" ToolTip.Tip="Eliminar"
                          Command="{Binding $parent[ItemsControl].DataContext.DeleteChildCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="280" Watermark="Nueva subtarea" Text="{Binding NewSubTaskTitle, Mode=TwoWay}"
                   KeyDown="OnNewSubTaskKeyDown" />
          <Button Content="Añadir" Command="{Binding AddSubTaskCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Comments -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Comentarios" Classes="h2" />
        <ItemsControl ItemsSource="{Binding Comments}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2" Margin="0,0,0,10">
                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                <TextBlock Classes="muted"
                           Text="{Binding CreatedAtUtc, Converter={x:Static conv:AppConverters.RelativeDateTime}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="420" AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap"
                   Watermark="Escribe un comentario…" Text="{Binding NewCommentBody, Mode=TwoWay}" />
          <Button Content="Comentar" Classes="accent" VerticalAlignment="Bottom"
                  Command="{Binding AddCommentCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Follow-ups & reminders -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Seguimientos y recordatorios" Classes="h2" />

        <ItemsControl ItemsSource="{Binding FollowUps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Spacing="1">
                  <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding WaitingOn, StringFormat='{}⏳ {0}'}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource SemWaitingBrush}"
                           Text="{Binding DaysWaiting, StringFormat='{}{0} d'}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding IsOpen}">
                  <Button Content="Recordatorio" Classes="quick"
                          Command="{Binding $parent[ItemsControl].DataContext.SendFollowUpReminderCommand}" CommandParameter="{Binding}" />
                  <Button Content="Respondió" Classes="quick"
                          Command="{Binding $parent[ItemsControl].DataContext.ResolveFollowUpCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Reminders}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Text="{Binding Text}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Margin="8,0"
                           Text="{Binding RemindAtUtc, Converter={x:Static conv:AppConverters.DayDelta}}" />
                <Button Grid.Column="2" Content="Hecho" Classes="quick" VerticalAlignment="Center"
                        Command="{Binding $parent[ItemsControl].DataContext.CompleteReminderCommand}" CommandParameter="{Binding}"
                        IsVisible="{Binding Status, Converter={x:Static conv:AppConverters.ReminderPending}}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Iniciar seguimiento" Classes="quick" Command="{Binding ToggleFollowUpPanelCommand}" />
          <Button Content="Nuevo recordatorio" Classes="quick" Command="{Binding ToggleReminderPanelCommand}" />
        </StackPanel>

        <Border Classes="tile" IsVisible="{Binding IsFollowUpPanelOpen}">
          <StackPanel Spacing="8">
            <TextBox Watermark="¿Qué estás esperando?" Text="{Binding FollowUpSubject, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Esperas a" Classes="muted" VerticalAlignment="Center" />
              <ComboBox Width="200" PlaceholderText="Persona…" ItemsSource="{Binding AllPeople}"
                        SelectedItem="{Binding FollowUpWaitingPerson, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Width="200" PlaceholderText="Empresa…" ItemsSource="{Binding AllCompanies}"
                        SelectedItem="{Binding FollowUpWaitingCompany, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBox Watermark="…o escríbelo (p. ej. «Sistemas», «Cliente»)" Text="{Binding FollowUpWaitingOn, Mode=TwoWay}" />
            <Button Content="Empezar a esperar" Classes="accent" HorizontalAlignment="Right"
                    Command="{Binding StartFollowUpCommand}" />
          </StackPanel>
        </Border>

        <Border Classes="tile" IsVisible="{Binding IsReminderPanelOpen}">
          <StackPanel Spacing="8">
            <TextBox Watermark="Recordarme…" Text="{Binding NewReminderText, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <DatePicker SelectedDate="{Binding NewReminderDate, Mode=TwoWay}" />
              <TimePicker SelectedTime="{Binding NewReminderTime, Mode=TwoWay}" ClockIdentifier="24HourClock" />
              <Button Content="Crear recordatorio" Classes="accent" Command="{Binding AddReminderCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Attachments -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Adjuntos" Classes="h2" />
        <shared:AttachmentsPanel DataContext="{Binding Attachments}" />
      </StackPanel>
    </Border>

    <!-- Template -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="Plantilla" Classes="h2" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Guardar como plantilla" Classes="quick"
                  Command="{Binding ToggleTemplatePanelCommand}" />
        </Grid>
        <StackPanel Spacing="8" IsVisible="{Binding IsTemplatePanelOpen}">
          <TextBox Watermark="Nombre de la plantilla" Text="{Binding TemplateName, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Cancelar" Command="{Binding ToggleTemplatePanelCommand}" />
            <Button Content="Guardar" Classes="accent" Command="{Binding SaveAsTemplateCommand}" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding TemplateMessage}" Classes="muted"
                   IsVisible="{Binding TemplateMessage, Converter={x:Static conv:AppConverters.HasText}}" />
      </StackPanel>
    </Border>

    <!-- History -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Historial (inmutable)" Classes="h2" />
        <ItemsControl ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <TextBlock Grid.Column="0" Classes="muted" MinWidth="140"
                           Text="{Binding OccurredAtUtc, Converter={x:Static conv:AppConverters.LocalDateTime}}" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding Note}"
                             IsVisible="{Binding Note, Converter={x:Static conv:AppConverters.HasText}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

  </StackPanel>

</UserControl>
