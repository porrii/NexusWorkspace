<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Name="Root"
             x:Class="NexusWorkspace.UI.Views.Tasks.TasksView">

  <StackPanel Spacing="16" MaxWidth="1040">

    <TextBlock Text="Tareas" Classes="h1" />

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />

    <!-- Filtros -->
    <Border Classes="card">
      <WrapPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
          <TextBlock Text="Proyecto" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Width="190" ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
          <TextBlock Text="Responsable" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Width="170" ItemsSource="{Binding AssigneeOptions}" SelectedItem="{Binding SelectedAssignee, Mode=TwoWay}">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
          <TextBlock Text="Estado" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Width="160" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
          <TextBlock Text="Prioridad" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Width="150" ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriority, Mode=TwoWay}">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,14,6" VerticalAlignment="Center">
          <CheckBox Content="Solo abiertas" IsChecked="{Binding OpenOnly, Mode=TwoWay}" />
          <CheckBox Content="Solo vencidas" IsChecked="{Binding OverdueOnly, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <TextBox Width="190" Watermark="Buscar por título…" Text="{Binding SearchText, Mode=TwoWay}" />
          <Button Content="Buscar" Command="{Binding ApplySearchCommand}" />
          <Button Content="Limpiar" Classes="quick" Command="{Binding ClearFiltersCommand}" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <TextBlock Text="{Binding Tasks.Count, StringFormat='{}{0} tarea(s)'}" Classes="muted" />

    <ItemsControl ItemsSource="{Binding Tasks}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="tile" Margin="0,0,0,8">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="quick" Padding="6,4" VerticalAlignment="Top" Margin="0,0,8,0"
                        ToolTip.Tip="Ver subtareas"
                        Command="{Binding $parent[ItemsControl].DataContext.ToggleExpandCommand}" CommandParameter="{Binding}">
                  <mi:MaterialIcon Width="14" Height="14" Kind="{Binding IsExpanded, Converter={x:Static conv:AppConverters.ExpandChevron}}" />
                </Button>

                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding $parent[ItemsControl].DataContext.OpenTaskCommand}" CommandParameter="{Binding Item}">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock Text="{Binding Item.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="muted" Text="{Binding Item.ProjectName}" />
                        <TextBlock Classes="muted" Text="{Binding Item.AssigneeName, StringFormat='{}· {0}'}"
                                   IsVisible="{Binding Item.AssigneeName, Converter={x:Static conv:AppConverters.HasText}}" />
                        <TextBlock Classes="muted"
                                   Text="{Binding Item.DueDateUtc, Converter={x:Static conv:AppConverters.LocalDate}, StringFormat='{}· vence {0}'}"
                                   IsVisible="{Binding Item.DueDateUtc, Converter={x:Static conv:AppConverters.IsNotNull}}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Classes="pill" BorderBrush="{Binding Item.Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}">
                        <TextBlock Text="{Binding Item.Priority, Converter={x:Static conv:AppConverters.EnumLabel}}"
                                   Foreground="{Binding Item.Priority, Converter={x:Static conv:AppConverters.PriorityBrush}}" />
                      </Border>
                      <Border Classes="pill" BorderBrush="{Binding Item.Status, Converter={x:Static conv:AppConverters.TaskStatusBrush}}">
                        <TextBlock Text="{Binding Item.Status, Converter={x:Static conv:AppConverters.EnumLabel}}"
                                   Foreground="{Binding Item.Status, Converter={x:Static conv:AppConverters.TaskStatusBrush}}" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Button>
              </Grid>

              <StackPanel IsVisible="{Binding IsExpanded}" Margin="30,0,0,0" Spacing="8">
                <TextBlock Text="Cargando…" Classes="muted" IsVisible="{Binding IsLoadingChildren}" />

                <StackPanel IsVisible="{Binding ChildrenLoaded}" Spacing="8">
                  <ItemsControl ItemsSource="{Binding Children}"
                                IsVisible="{Binding Children.Count, Converter={x:Static conv:AppConverters.Positive}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsDone, Mode=OneWay}"
                                    Command="{Binding #Root.DataContext.ToggleChildCommand}"
                                    CommandParameter="{Binding}" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel IsVisible="{Binding Children.Count, Converter={x:Static conv:AppConverters.IsZero}}" Spacing="8">
                    <TextBlock Text="Sin subtareas." Classes="muted"
                               IsVisible="{Binding Comments.Count, Converter={x:Static conv:AppConverters.IsZero}}" />
                    <ItemsControl ItemsSource="{Binding Comments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Spacing="2" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted"
                                       Text="{Binding CreatedAtUtc, Converter={x:Static conv:AppConverters.RelativeDateTime}}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="No hay tareas que coincidan con los filtros." Classes="muted"
               IsVisible="{Binding IsEmpty}" />

  </StackPanel>

</UserControl>
