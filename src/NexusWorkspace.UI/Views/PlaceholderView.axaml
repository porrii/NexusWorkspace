<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NexusWorkspace.UI.Views.PlaceholderView">

  <StackPanel Spacing="10" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center">
    <mi:MaterialIcon Kind="ClockOutline" Width="40" Height="40"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource AppMutedBrush}" />
    <TextBlock Text="{Binding Title}" Classes="h1" HorizontalAlignment="Center" />
    <TextBlock Text="{Binding Description}" Classes="muted"
               TextAlignment="Center" TextWrapping="Wrap" />
  </StackPanel>

</UserControl>
