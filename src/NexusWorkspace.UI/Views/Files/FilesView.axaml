<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.Files.FilesView">

  <StackPanel Spacing="16" MaxWidth="1100">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Archivos" Classes="h1" />
        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} adjuntos en todo el espacio de trabajo'}" Classes="muted" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBox Grid.Column="0" Watermark="Buscar por nombre de archivo…" Margin="0,0,10,0"
               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox Grid.Column="1" Width="200" Margin="0,0,10,0"
                ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Grid.Column="2" Width="180"
                ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />

    <ItemsControl ItemsSource="{Binding Files}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="tile" Width="210" Margin="0,0,12,12" Padding="0" ClipToBounds="True">
            <StackPanel>
              <Panel Height="120" Background="{DynamicResource AppSurfaceAltBrush}">
                <Image Stretch="UniformToFill" MaxHeight="120"
                       Source="{Binding AbsolutePath, Converter={x:Static conv:AppConverters.Thumbnail}}"
                       IsVisible="{Binding IsImage}" />
                <mi:MaterialIcon Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Kind="{Binding Kind, Converter={x:Static conv:AppConverters.AttachmentKindIcon}}"
                                 Foreground="{DynamicResource AppMutedBrush}"
                                 IsVisible="{Binding !IsImage}" />
              </Panel>
              <StackPanel Spacing="4" Margin="12">
                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding HumanSize}" Classes="muted" />
                  <TextBlock Text="{Binding CreatedAtUtc, Converter={x:Static conv:AppConverters.RelativeDate}}" Classes="muted" />
                </StackPanel>
                <Button Classes="quick" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                        Command="{Binding $parent[ItemsControl].DataContext.OpenOwnerCommand}" CommandParameter="{Binding}"
                        IsVisible="{Binding ProjectName, Converter={x:Static conv:AppConverters.HasText}}">
                  <TextBlock Text="{Binding ProjectName, StringFormat='{}📁 {0}'}" Classes="muted" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                  <Button Classes="quick" Padding="6,3" ToolTip.Tip="Abrir"
                          Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="OpenInNew" Width="13" Height="13" />
                  </Button>
                  <Button Classes="quick" Padding="6,3" ToolTip.Tip="Mostrar en carpeta"
                          Command="{Binding $parent[ItemsControl].DataContext.RevealCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="FolderSearchOutline" Width="13" Height="13" />
                  </Button>
                  <Button Classes="quick" Padding="6,3" ToolTip.Tip="Ir al elemento"
                          Command="{Binding $parent[ItemsControl].DataContext.OpenOwnerCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="ArrowTopRight" Width="13" Height="13" />
                  </Button>
                  <Button Classes="quick" Padding="6,3" ToolTip.Tip="Quitar"
                          Command="{Binding $parent[ItemsControl].DataContext.RemoveCommand}" CommandParameter="{Binding}">
                    <mi:MaterialIcon Kind="TrashCanOutline" Width="13" Height="13" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Spacing="6" IsVisible="{Binding IsEmpty}" Margin="0,20,0,0" HorizontalAlignment="Center">
      <mi:MaterialIcon Kind="FolderOpenOutline" Width="34" Height="34" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppMutedBrush}" />
      <TextBlock Text="No hay archivos que coincidan." Classes="muted" HorizontalAlignment="Center" />
      <TextBlock Text="Adjunta archivos desde una tarea o un proyecto." Classes="muted" HorizontalAlignment="Center" />
    </StackPanel>

  </StackPanel>

</UserControl>
