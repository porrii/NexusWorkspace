<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.Search.SearchView"
             Width="640">

  <Border Background="{DynamicResource AppSurfaceBrush}"
          BorderBrush="{DynamicResource AppLineStrongBrush}"
          BorderThickness="1" CornerRadius="14" Padding="8"
          BoxShadow="0 24 70 -24 #66000000">
    <DockPanel>

      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="8,6,8,8">
        <mi:MaterialIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                         VerticalAlignment="Center" Margin="0,0,10,0"
                         Foreground="{DynamicResource AppMutedBrush}" />
        <TextBox x:Name="Input" Grid.Column="1" BorderThickness="0" Background="Transparent"
                 FontSize="15" Watermark="Buscar en proyectos, tareas y comentarios…  (Ctrl+F)"
                 Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>

      <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}"
                 Foreground="{DynamicResource SemCriticalBrush}" Margin="8,4"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />

      <TextBlock DockPanel.Dock="Bottom" Text="Sin resultados." Classes="muted" Margin="10,8"
                 IsVisible="{Binding NoResults}" />

      <ListBox MaxHeight="420" ItemsSource="{Binding Results}"
               Background="Transparent" BorderThickness="0"
               DoubleTapped="OnActivate">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="2" Margin="2,6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="pill" BorderBrush="{DynamicResource AppLineStrongBrush}">
                  <TextBlock Text="{Binding EntityKind}" Foreground="{DynamicResource AppMutedBrush}" />
                </Border>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Snippet}" Classes="muted" TextWrapping="Wrap"
                         IsVisible="{Binding Snippet, Converter={x:Static conv:AppConverters.HasText}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </DockPanel>
  </Border>

</UserControl>
