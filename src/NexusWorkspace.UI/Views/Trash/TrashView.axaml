<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.Trash.TrashView">

  <StackPanel Spacing="16" MaxWidth="960">

    <Grid ColumnDefinitions="*,Auto,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="Papelera y archivados" Classes="h1" />
        <TextBlock Text="Nada se pierde: aquí puedes restaurar o eliminar de forma permanente (con copia previa)." Classes="muted" />
      </StackPanel>
      <ComboBox Grid.Column="1" Width="200" Margin="0,0,8,0"
                ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope, Mode=TwoWay}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static conv:AppConverters.EnumLabel}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2" Content="Vaciar papelera" Classes="quick" Command="{Binding AskEmptyCommand}" />
    </Grid>

    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource SemCriticalBrush}"
               IsVisible="{Binding ErrorMessage, Converter={x:Static conv:AppConverters.HasText}}" />
    <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap"
               IsVisible="{Binding StatusMessage, Converter={x:Static conv:AppConverters.HasText}}" />

    <Border Classes="card" Background="{DynamicResource AppAccentWashBrush}"
            IsVisible="{Binding PendingPurge, Converter={x:Static conv:AppConverters.IsNotNull}}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding PendingPurge.Name, StringFormat='{}Vas a eliminar «{0}» de forma permanente.'}"
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Se guardará una copia de seguridad antes. Esta acción no se puede deshacer." Classes="muted" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Sí, eliminar" Classes="accent" Command="{Binding ConfirmPurgeCommand}" />
          <Button Content="Cancelar" Command="{Binding CancelPurgeCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" Background="{DynamicResource AppAccentWashBrush}" IsVisible="{Binding ConfirmingEmpty}">
      <StackPanel Spacing="8">
        <TextBlock Text="Vaciar la papelera elimina de forma permanente todo lo que hay en ella." FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="Se guardará una copia de seguridad antes." Classes="muted" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Sí, vaciar" Classes="accent" Command="{Binding ConfirmEmptyCommand}" />
          <Button Content="Cancelar" Command="{Binding CancelPurgeCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Entries}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="row" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
              <Border Grid.Column="0" Classes="pill" Margin="0,0,10,0" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource AppLineStrongBrush}">
                <TextBlock Text="{Binding Kind, Converter={x:Static conv:AppConverters.EnumLabel}}"
                           Foreground="{DynamicResource AppMutedBrush}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="muted" Text="{Binding Context}"
                             IsVisible="{Binding Context, Converter={x:Static conv:AppConverters.HasText}}" />
                  <TextBlock Classes="muted" Text="En papelera" IsVisible="{Binding IsDeleted}" />
                  <TextBlock Classes="muted" Text="Archivado" IsVisible="{Binding IsArchived}" />
                  <TextBlock Classes="muted"
                             Text="{Binding WhenUtc, Converter={x:Static conv:AppConverters.RelativeDateTime}}" />
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="2" Classes="quick" Content="Abrir" Margin="0,0,6,0"
                      Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}" CommandParameter="{Binding}" />
              <Button Grid.Column="3" Classes="quick" Content="Restaurar" Margin="0,0,6,0"
                      Command="{Binding $parent[ItemsControl].DataContext.RestoreCommand}" CommandParameter="{Binding}" />
              <Button Grid.Column="4" Classes="quick" Content="Eliminar…"
                      Command="{Binding $parent[ItemsControl].DataContext.AskPurgeCommand}" CommandParameter="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Spacing="6" IsVisible="{Binding IsEmpty}" Margin="0,20,0,0" HorizontalAlignment="Center">
      <mi:MaterialIcon Kind="DeleteEmptyOutline" Width="34" Height="34" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppMutedBrush}" />
      <TextBlock Text="No hay nada archivado ni en la papelera." Classes="muted" HorizontalAlignment="Center" />
    </StackPanel>

  </StackPanel>

</UserControl>
