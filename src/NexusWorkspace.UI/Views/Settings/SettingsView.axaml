<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="clr-namespace:NexusWorkspace.UI.Converters"
             x:Class="NexusWorkspace.UI.Views.Settings.SettingsView">

  <StackPanel Spacing="16" MaxWidth="760">

    <TextBlock Text="Configuración" Classes="h1" />

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Apariencia" Classes="h2" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Tema" VerticalAlignment="Center" Classes="muted" />
          <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Width="200" />
        </StackPanel>
        <TextBlock Classes="muted" Text="«Sistema» sigue el tema del sistema operativo." />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Base de datos y archivos" Classes="h2" />
        <TextBlock Classes="muted" Text="{Binding DataFolder, StringFormat='{}Carpeta de datos: {0}'}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="Modo portable activo." IsVisible="{Binding IsPortable}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Abrir carpeta de datos" Command="{Binding OpenDataFolderCommand}" />
          <Button Content="Abrir carpeta de logs" Command="{Binding OpenLogsFolderCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Datos de demostración" Classes="h2" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Crea un proyecto de ejemplo con tareas, subtareas, checklist, comentarios e historial. Se puede eliminar por completo." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Cargar datos de demostración" Classes="accent"
                  IsEnabled="{Binding !DemoDataPresent}"
                  Command="{Binding LoadDemoDataCommand}" />
          <Button Content="Eliminar datos de demostración"
                  IsEnabled="{Binding DemoDataPresent}"
                  Command="{Binding RemoveDemoDataCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="muted"
                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:AppConverters.HasText}}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Inicio y notificaciones" Classes="h2" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Sección al arrancar" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Width="200" ItemsSource="{Binding StartupSectionOptions}" SelectedItem="{Binding StartupSection, Mode=TwoWay}" />
        </StackPanel>
        <CheckBox Content="Notificaciones activadas" IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
        <CheckBox Content="Mostrar recordatorios pendientes al arrancar" IsChecked="{Binding RemindersOnStartup, Mode=TwoWay}" />
        <CheckBox Content="Avisos de seguimientos que llevan tiempo esperando" IsChecked="{Binding FollowUpNudges, Mode=TwoWay}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Copias de seguridad" Classes="h2" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Programación" Classes="muted" VerticalAlignment="Center" />
          <ComboBox Width="140" ItemsSource="{Binding BackupScheduleOptions}" SelectedItem="{Binding BackupSchedule, Mode=TwoWay}" />
          <TextBlock Text="Conservar" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
          <NumericUpDown Width="110" Minimum="1" Maximum="999" Increment="1" Value="{Binding KeepVersions, Mode=TwoWay}" />
        </StackPanel>
        <CheckBox Content="Crear copia antes de aplicar migraciones" IsChecked="{Binding BackupBeforeMigration, Mode=TwoWay}" />
        <CheckBox Content="Incluir los archivos adjuntos en las copias manuales" IsChecked="{Binding IncludeFilesInBackup, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Crear copia ahora" Classes="accent" Command="{Binding CreateBackupNowCommand}" />
          <Button Content="Abrir carpeta de copias" Command="{Binding OpenBackupsFolderCommand}" />
          <Button Content="Exportar workspace…" Click="OnExportWorkspaceClicked" />
          <Button Content="Importar workspace…" Click="OnImportWorkspaceClicked" />
        </StackPanel>

        <Border Padding="10" CornerRadius="8" Background="{DynamicResource AppAccentWashBrush}"
                IsVisible="{Binding RestartRequired}">
          <TextBlock Text="Hay una restauración o importación preparada. Cierra y vuelve a abrir NexusWorkspace para aplicarla." TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="{Binding BackupStatus}" Classes="muted" TextWrapping="Wrap"
                   IsVisible="{Binding BackupStatus, Converter={x:Static conv:AppConverters.HasText}}" />

        <ItemsControl ItemsSource="{Binding Backups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="row" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="muted" Text="{Binding CreatedAtUtc, Converter={x:Static conv:AppConverters.RelativeDateTime}}" />
                      <TextBlock Classes="muted" Text="{Binding Reason}" />
                      <TextBlock Classes="muted" Text="con adjuntos" IsVisible="{Binding IncludesFiles}" />
                    </StackPanel>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="quick" Content="Restaurar" Margin="0,0,6,0"
                          Command="{Binding $parent[ItemsControl].DataContext.RestoreBackupCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="quick" Content="Eliminar"
                          Command="{Binding $parent[ItemsControl].DataContext.DeleteBackupCommand}" CommandParameter="{Binding}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="Importar datos" Classes="h2" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Pega JSON (con un array «projects») o notas indentadas: una línea sin sangría es un proyecto o tarea, la sangría crea subtareas, «- » o «- [ ]» crean ítems de checklist, un «!» final marca prioridad alta y «!!» crítica." />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Formato" Classes="muted" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding ImportSources}" SelectedItem="{Binding ImportSource, Mode=TwoWay}" Width="140" />
        </StackPanel>
        <TextBox AcceptsReturn="True" MinHeight="140" TextWrapping="NoWrap" FontFamily="Consolas, monospace"
                 Watermark="Pega aquí el contenido a importar…" Text="{Binding ImportText, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />

        <Border Padding="10" CornerRadius="8" Background="{DynamicResource AppSurfaceAltBrush}" IsVisible="{Binding IsCsvImport}">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Separador" Classes="muted" VerticalAlignment="Center" />
              <TextBox Width="60" Text="{Binding CsvDelimiter, Mode=TwoWay}" />
              <Button Content="Detectar columnas" Command="{Binding DetectCsvColumnsCommand}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="130,*">
                <TextBlock Grid.Column="0" Text="Tarea (título)" Classes="muted" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CsvColumns}" SelectedItem="{Binding CsvTaskColumn, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="130,*">
                <TextBlock Grid.Column="0" Text="Proyecto" Classes="muted" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CsvColumns}" SelectedItem="{Binding CsvProjectColumn, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="130,*">
                <TextBlock Grid.Column="0" Text="Prioridad" Classes="muted" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CsvColumns}" SelectedItem="{Binding CsvPriorityColumn, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="130,*">
                <TextBlock Grid.Column="0" Text="Descripción" Classes="muted" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CsvColumns}" SelectedItem="{Binding CsvDescriptionColumn, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnDefinitions="130,*">
                <TextBlock Grid.Column="0" Text="Subtareas" Classes="muted" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding CsvColumns}" SelectedItem="{Binding CsvChecklistColumn, Mode=TwoWay}" />
              </Grid>
            </StackPanel>
            <TextBlock Classes="muted" Text="Se requiere una fila de cabecera. Varias subtareas en una misma celda se separan con «;» o «|»." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Previsualizar" Command="{Binding PreviewImportCommand}" />
          <Button Content="Importar" Classes="accent" Command="{Binding CommitImportCommand}"
                  IsEnabled="{Binding HasPreview}" />
        </StackPanel>
        <TextBlock Text="{Binding ImportStatus}" Classes="muted" TextWrapping="Wrap"
                   IsVisible="{Binding ImportStatus, Converter={x:Static conv:AppConverters.HasText}}" />
        <ItemsControl ItemsSource="{Binding ImportPreview.Projects}" IsVisible="{Binding HasPreview}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="row" Margin="0,0,0,6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="{Binding Tasks.Count, StringFormat='{}{0} tareas de primer nivel'}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <TextBlock Classes="muted"
               Text="Más categorías (Atajos, Notificaciones, Backup, Privacidad…) llegan en fases posteriores." />

  </StackPanel>

</UserControl>
