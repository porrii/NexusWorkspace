root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,axaml,xaml,config}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# --- Language conventions ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# --- Naming: interfaces start with I, private fields _camelCase ---
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_style
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix_style
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix_style.required_prefix = _
dotnet_naming_style.underscore_prefix_style.capitalization = camel_case

# Analyzer noise we intentionally accept in this codebase
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates — not worth it here
dotnet_diagnostic.CA1031.severity = none   # broad catch is deliberate in a few resilient paths
dotnet_diagnostic.CA1305.severity = none   # UI date formatting uses the current culture on purpose
dotnet_diagnostic.CA1822.severity = none   # false positive for XAML-bound instance members
dotnet_diagnostic.CA1001.severity = none   # CancellationTokenSource fields, replaced not disposed
dotnet_diagnostic.CA1861.severity = none   # inline constant arrays as args are fine
dotnet_diagnostic.CA2007.severity = none   # UI code intentionally resumes on the UI thread
dotnet_diagnostic.CA1707.severity = none   # test method names use underscores
dotnet_diagnostic.CA1515.severity = none   # public types in an app assembly are fine
dotnet_diagnostic.CA1859.severity = none   # micro-perf return-type hints, noisy in async code
dotnet_diagnostic.CA1716.severity = none   # cross-language keyword clashes (VB) — C#-only project
dotnet_diagnostic.CA1000.severity = none   # static members on generic types (cf. Enumerable.Empty<T>)

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
